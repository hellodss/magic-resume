{
  "name": "magic-resume",
  "productName": "Magic Resume",
  "version": "2.0.10",
  "description": "一款注重隐私的本地简历编辑与导出工具",
  "author": "Magic Resume Contributors",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "desktop/main.mjs",
  "packageManager": "pnpm@10.3.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node server.mjs",
    "preview": "vite preview",
    "desktop:run": "pnpm build && electron .",
    "desktop:pack": "pnpm build && electron-builder --dir",
    "desktop:dist": "pnpm build && electron-builder",
    "desktop:dist:win": "pnpm build && electron-builder --win nsis",
    "desktop:portable:win": "pnpm build && electron-builder --win portable --config.directories.output=release/portable",
    "release": "bumpp",
    "generate:template-snapshots": "tsx scripts/generate-template-snapshots.ts",
    "install:playwright": "playwright install chromium"
  },
  "dependencies": {
